# Google GenAI (gemini) — if using init_chat_model("google_genai:...")
GOOGLE_API_KEY=

# OpenRouter — if using init_chat_model("openrouter:...") note: it does not work using google api only
OPENROUTER_API_KEY=

# Optional: Hugging Face token for higher embedding download rate limits
# HF_TOKEN=
# use gemini embedding model as i haved used huggingface embedding model in the past for saving the money 
# Logging (console + rotating file at logs/agent.log)
LOG_LEVEL=INFO
LOG_TO_FILE=true
# LOG_FILE=logs/agent.log

# Local API (localhost only — used by Streamlit)
# API_HOST=127.0.0.1
# API_PORT=8000

# Evaluation: seconds between live agent cases (avoids provider rate limits)
# EVAL_CASE_DELAY=6
